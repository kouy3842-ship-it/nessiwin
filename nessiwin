cachedRayParams.FilterType = Enum.RaycastFilterType.Blacklist

local function isVisible(targetPart, originPos)
    if not targetPart then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local myHead = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not myHead then return false end
    local origin = originPos or myHead.Position
    local direction = (targetPart.Position - origin)
    local dist = direction.Magnitude
    if dist > 0 then
        cachedRayParams.FilterDescendantsInstances = {char, targetPart.Parent}
        local result = Workspace:Raycast(origin, direction.Unit * dist, cachedRayParams)
        if result then return false end
    end
    return true
end

-- ==================== TARGET SELECTION ENGINE ====================
local function getAimbotTarget(maxDist, fov, requireVisible, targetPartName)
    local char = LocalPlayer.Character
    if not char then return nil end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    local myHead = char:FindFirstChild("Head")
    if not myRoot then return nil end
    local cam = Camera
    local camPos = cam.CFrame.Position
    local bestTarget = nil
    local bestScore = math.huge
    local mousePos = UserInputService:GetMouseLocation()
    local partName = targetPartName or (Options.Target_Part and Options.Target_Part.Value) or "Head"
    local priority = Options.Target_Priority and Options.Target_Priority.Value or "Distance"

    for _, player in next, playerCache do
        local targetChar = player.Character
        if not targetChar then continue end
        local targetPart = targetChar:FindFirstChild(partName == "Random" and "Head" or partName)
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
        if not (targetPart and targetRoot and targetHum and targetHum.Health > 0) then continue end

        local dist = (myRoot.Position - targetRoot.Position).Magnitude
        if dist > maxDist then continue end

        if requireVisible and not isVisible(targetPart, myHead and myHead.Position) then continue end

        local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
        if not onScreen then continue end

        local fovDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if fovDist > fov then continue end

        local score
        if priority == "Distance" then
            score = dist
        elseif priority == "Health" then
            score = targetHum.Health
        elseif priority == "FOV" then
            score = fovDist
        else
            score = dist
        end

        if score < bestScore then
            bestScore = score
            bestTarget = {Player = player, Character = targetChar, Part = targetPart, Root = targetRoot, Humanoid = targetHum, ScreenPos = screenPos}
        end
    end
    return bestTarget
end

