local speedLockConnection = nil

local function attachSpeedLock(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if speedLockConnection then pcall(function() speedLockConnection:Disconnect() end) end
    speedLockConnection = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if Toggles.Misc_SpeedEnabled and Toggles.Misc_SpeedEnabled.Value then
            local target = Options.Misc_SpeedValue and Options.Misc_SpeedValue.Value or 16
            if hum.WalkSpeed ~= target then hum.WalkSpeed = target end
        end
    end)
end

