-- ==================== OPTIMIZED ESP SYSTEM ====================
local espCache = {}
local chamsCache = {}

local function removeESP(player)
    local cache = espCache[player]
    if cache then
        for _, drawing in next, cache do
            pcall(function() drawing:Remove() end)
        end
        espCache[player] = nil
    end
    local cham = chamsCache[player]
    if cham then
        pcall(function() cham:Destroy() end)
        chamsCache[player] = nil
    end
end

local function setupESP(player)
    if player == LocalPlayer then return end
    local drawings = {
        Box = Drawing.new("Square"),
        BoxOutline = Drawing.new("Square"),
        Tracer = Drawing.new("Line"),
        HealthBar = Drawing.new("Line"),
        HealthBarOutline = Drawing.new("Line"),
        NameTag = Drawing.new("Text")
    }
    drawings.Box.Filled = false; drawings.Box.Thickness = 1; drawings.Box.Transparency = 1
    drawings.BoxOutline.Filled = false; drawings.BoxOutline.Thickness = 2; drawings.BoxOutline.Transparency = 1; drawings.BoxOutline.Color = Color3.new(0, 0, 0)
    drawings.Tracer.Thickness = 1; drawings.Tracer.Transparency = 1
    drawings.HealthBar.Thickness = 2; drawings.HealthBarOutline.Thickness = 4; drawings.HealthBarOutline.Color = Color3.new(0, 0, 0)
    drawings.NameTag.Size = 14; drawings.NameTag.Center = true; drawings.NameTag.Outline = true; drawings.NameTag.Color = Color3.new(1, 1, 1)
    espCache[player] = drawings
end

Players.PlayerRemoving:Connect(removeESP)
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then setupESP(player) end
end
Players.PlayerAdded:Connect(setupESP)

RunService.RenderStepped:Connect(function()
    local espMaster = Toggles.ESP_Master and Toggles.ESP_Master.Value
    local boxEnabled = Toggles.ESP_Box and Toggles.ESP_Box.Value
    local lineEnabled = Toggles.ESP_Line and Toggles.ESP_Line.Value
    local healthEnabled = Toggles.ESP_Health and Toggles.ESP_Health.Value
    local nameEnabled = Toggles.ESP_Name and Toggles.ESP_Name.Value
    local distEnabled = Toggles.ESP_Distance and Toggles.ESP_Distance.Value
    local chamsEnabled = Toggles.ESP_Chams and Toggles.ESP_Chams.Value
    local boxColor = Options.BoxColor and Options.BoxColor.Value or Color3.fromRGB(255, 0, 0)
    local lineColor = Options.LineColor and Options.LineColor.Value or Color3.fromRGB(255, 255, 255)
    local chamsColor = Options.ChamsColor and Options.ChamsColor.Value or Color3.fromRGB(0, 255, 0)
    local cam = Camera
    local vpSize = cam.ViewportSize
    local camPos = cam.CFrame.Position

    for player, drawings in next, espCache do
        local character = player.Character
        if not character then
            drawings.Box.Visible = false; drawings.BoxOutline.Visible = false; drawings.Tracer.Visible = false
            drawings.HealthBar.Visible = false; drawings.HealthBarOutline.Visible = false; drawings.NameTag.Visible = false
            continue
        end
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local head = character:FindFirstChild("Head")

        if espMaster and rootPart and humanoid and humanoid.Health > 0 then
            local vector, onScreen = cam:WorldToViewportPoint(rootPart.Position)
            if onScreen then
                local topPos = head and cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or vector
                local legPos = cam:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
                local height = math.abs(topPos.Y - legPos.Y)
                local width = height / 2
                local xPos = vector.X - width / 2
                local yPos = topPos.Y

                if boxEnabled then
                    drawings.Box.Visible = true; drawings.BoxOutline.Visible = true
                    drawings.Box.Size = Vector2.new(width, height)
                    drawings.Box.Position = Vector2.new(xPos, yPos)
                    drawings.Box.Color = boxColor
                    drawings.BoxOutline.Size = drawings.Box.Size
                    drawings.BoxOutline.Position = drawings.Box.Position
                else
                    drawings.Box.Visible = false; drawings.BoxOutline.Visible = false
                end

                if lineEnabled then
                    drawings.Tracer.Visible = true
                    drawings.Tracer.From = Vector2.new(vpSize.X / 2, vpSize.Y)
                    drawings.Tracer.To = Vector2.new(vector.X, legPos.Y)
                    drawings.Tracer.Color = lineColor
                else
                    drawings.Tracer.Visible = false
                end

                if healthEnabled then
                    drawings.HealthBar.Visible = true; drawings.HealthBarOutline.Visible = true
                    local hpPct = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                    local barH = height * hpPct
                    local barX = xPos - 6
                    drawings.HealthBarOutline.From = Vector2.new(barX, topPos.Y + height)
                    drawings.HealthBarOutline.To = Vector2.new(barX, topPos.Y)
                    drawings.HealthBar.From = Vector2.new(barX, topPos.Y + height)
                    drawings.HealthBar.To = Vector2.new(barX, topPos.Y + height - barH)
                    drawings.HealthBar.Color = Color3.fromRGB(0, 255, 0):Lerp(Color3.fromRGB(255, 0, 0), 1 - hpPct)
                else
                    drawings.HealthBar.Visible = false; drawings.HealthBarOutline.Visible = false
                end

                if nameEnabled then
                    drawings.NameTag.Visible = true
                    local dist = math.floor((camPos - rootPart.Position).Magnitude)
                    local txt = player.Name .. " [" .. math.floor(humanoid.Health) .. "HP]"
                    if distEnabled then txt = txt .. " [" .. dist .. "m]" end
                    drawings.NameTag.Text = txt
                    drawings.NameTag.Position = Vector2.new(vector.X, topPos.Y - 18)
                else
                    drawings.NameTag.Visible = false
                end
            else
                drawings.Box.Visible = false; drawings.BoxOutline.Visible = false;
                drawings.NameTag.Visible = false
            end
        else
            drawings.Box.Visible = false; drawings.BoxOutline.Visible = false; drawings.Tracer.Visible = false
            drawings.HealthBar.Visible = false; drawings.HealthBarOutline.Visible = false; drawings.NameTag.Visible = false
        end

        if chamsEnabled and character then
            if not chamsCache[player] then
                local hl = Instance.new("Highlight")
                hl.FillColor = chamsColor; hl.OutlineColor = Color3.new(0,0,0)
                hl.FillTransparency = 0.5; hl.OutlineTransparency = 0
                hl.Adornee = character; hl.Parent = character
                chamsCache[player] = hl
            else
                local hl = chamsCache[player]
                hl.FillColor = chamsColor; hl.Enabled = true
            end
        elseif chamsCache[player] then
            chamsCache[player].Enabled = false
        end
    end
end)

