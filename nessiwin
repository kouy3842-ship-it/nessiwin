    if not root or not hum then return end
    local flyEnabled = Toggles.Misc_FlyEnabled and Toggles.Misc_FlyEnabled.Value
    local flySpeed = Options.Misc_FlySpeed and Options.Misc_FlySpeed.Value or 50
    if flyEnabled then
        hum.PlatformStand = true
