local function createLine(parent, size, pos, color)
    local f = Instance.new("Frame")
    f.Size = size; f.Position = pos; f.BackgroundColor3 = color; f.BorderSizePixel = 0; f.ZIndex = 5; f.Parent = parent
    local s = Instance.new("UIStroke"); s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Color = Color3.new(0,0,0); s.Thickness = 1; s.Parent = f
    return f
end

local function getRainbowColor(t)
    return Color3.fromHSV((t * 0.5) % 1, 1, 1)
end

local function smoothPulse(t, speed)
    return (math.sin(t * speed) + 1) / 2
end

local function calculateRotationSpeed(progress)
    return 180 + math.sin(progress * math.pi * 2) * 90
end

local function smoothRotation(current, target, factor)
    local diff = target - current
    while diff > 180 do diff = diff - 360 end
    while diff < -180 do diff = diff + 360 end
    return current + diff * factor
end

