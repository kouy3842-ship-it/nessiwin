local MapPainterGroup = Tabs.Visuals:AddRightGroupbox('Map Painter')
MapPainterGroup:AddToggle('MapPainter_Master', { Text = 'Enable Map Painter', Default = false })
MapPainterGroup:AddColorPicker('MapPainter_Base', { Default = Color3.fromRGB(200, 200, 200), Title = 'Base Color' })
MapPainterGroup:AddColorPicker('MapPainter_Accent', { Default = Color3.fromRGB(0, 255, 255), Title = 'Accent / Neon' })
MapPainterGroup:AddColorPicker('MapPainter_Detail', { Default = Color3.fromRGB(150, 150, 150), Title = 'Detail / Trim' })
MapPainterGroup:AddDropdown('MapPainter_Material', { Text = 'Material Override', Default = 'Preserve', Values = {'Preserve', 'SmoothPlastic', 'Neon', 'Glass', 'Metal', 'ForceField', 'Wood', 'Concrete'}})
MapPainterGroup:AddSlider('MapPainter_Reflectance', { Text = 'Reflectance', Default = 0, Min = 0, Max = 1, Rounding = 2 })
MapPainterGroup:AddSlider('MapPainter_Transparency', { Text = 'Map Transparency', Default = 0, Min = 0, Max = 1, Rounding = 2 })
MapPainterGroup:AddToggle('MapPainter_NeonOnly', { Text = 'Target Neon Only', Default = false })
MapPainterGroup:AddToggle('MapPainter_PreserveChars', { Text = 'Exclude Characters', Default = true })

local mapParts = {}
local originalMapProps = {}
local mapScanIndex = 1
local lastFullScan = 0
local MAP_BATCH_SIZE = 120

local function shouldPaint(obj)
    if not obj:IsA("BasePart") then return false end
    if obj:IsA("Terrain") then return false end
    if Toggles.MapPainter_PreserveChars and Toggles.MapPainter_PreserveChars.Value then
        if Players:GetPlayerFromCharacter(obj:FindFirstAncestorOfClass("Model")) then return false end
    end
    local n = obj.Name:lower()
    if n:find("humanoid") or n:find("hitbox") or n:find("camera") or n:find("bullet") then return false end
    return true
end

local function cacheMapParts()
    mapParts = {}
    for _, obj in next, Workspace:GetDescendants() do
        if shouldPaint(obj) then table.insert(mapParts, obj) end
    end
    mapScanIndex = 1
    lastFullScan = tick()
end

Workspace.DescendantAdded:Connect(function(obj)
    if shouldPaint(obj) then table.insert(mapParts, obj) end
end)

Workspace.DescendantRemoving:Connect(function(obj)
    if originalMapProps[obj] then originalMapProps[obj] = nil end
end)

RunService.Heartbeat:Connect(function()
    local enabled = Toggles.MapPainter_Master and Toggles.MapPainter_Master.Value
    if not enabled then
        if next(originalMapProps) then
            for obj, props in next, originalMapProps do
                if obj.Parent then
                    pcall(function()
                        obj.Color = props.Color
                        obj.Material = props.Material
                        obj.Reflectance = props.Reflectance
                        obj.Transparency = props.Transparency
                    end)
                end
            end
            originalMapProps = {}
        end
        return
    end

    if tick() - lastFullScan > 10 then cacheMapParts() end

    local baseColor = Options.MapPainter_Base and Options.MapPainter_Base.Value or Color3.fromRGB(200,200,200)
    local accentColor = Options.MapPainter_Accent and Options.MapPainter_Accent.Value or Color3.fromRGB(0,255,255)
    local detailColor = Options.MapPainter_Detail and Options.MapPainter_Detail.Value or Color3.fromRGB(150,150,150)
    local matName = Options.MapPainter_Material and Options.MapPainter_Material.Value or "Preserve"
    local reflect = Options.MapPainter_Reflectance and Options.MapPainter_Reflectance.Value or 0
    local trans = Options.MapPainter_Transparency and Options.MapPainter_Transparency.Value or 0
    local neonOnly = Toggles.MapPainter_NeonOnly and Toggles.MapPainter_NeonOnly.Value
    local matEnum = matName ~= "Preserve" and Enum.Material[matName] or nil

    local processed = 0
    local total = #mapParts
    while processed < MAP_BATCH_SIZE and mapScanIndex <= total do
        local obj = mapParts[mapScanIndex]
        if obj and obj.Parent then
            if not originalMapProps[obj] then
                originalMapProps[obj] = {
                    Color = obj.Color, Material = obj.Material,
                    Reflectance = obj.Reflectance, Transparency = obj.Transparency
                }
            end

            local isNeon = obj.Material == Enum.Material.Neon
            local n = obj.Name:lower()

            if not (neonOnly and not isNeon) then
                pcall(function()
                    if isNeon or n:find("neon") or n:find("light") or n:find("glow") or n:find("lamp") then
                        obj.Color = accentColor
                    elseif n:find("detail") or n:find("trim") or n:find("decal") or obj:IsA("Decal") or obj:IsA("Texture") then
                        obj.Color = detailColor
                    else
                        obj.Color = baseColor
                    end
                    if matEnum then obj.Material = matEnum end
                    obj.Reflectance = reflect
                    obj.Transparency = trans
                end)
            end
        end
        mapScanIndex += 1
        processed += 1
    end

    if mapScanIndex > total then mapScanIndex = 1 end
end)

